<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <!-- Release identity lets live servers load the update when their loader retains the old assembly. -->
    <AssemblyName>VIP_Tag_4ill_1_3</AssemblyName>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="CounterStrikeSharp.API" Version="1.0.376" />
    <!-- Some SimpleAdmin API types reference MySqlConnector during plugin type discovery. -->
    <PackageReference Include="MySqlConnector" Version="2.3.7" GeneratePathProperty="true" />
  </ItemGroup>
  <ItemGroup>
    <Reference Include="VipCoreApi">
      <HintPath>..\..\VipCoreApi.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <!-- CS2-SimpleAdmin public API (gag/silence). Compile-time only; the real DLL ships with
         CS2-SimpleAdmin on the server. Private=false so no local copy is emitted. -->
    <Reference Include="CS2-SimpleAdminApi">
      <HintPath>3rd_party\CS2-SimpleAdminApi.dll</HintPath>
      <Private>False</Private>
    </Reference>
  </ItemGroup>
  <Target Name="CopyMySqlConnector" AfterTargets="Build">
    <Copy SourceFiles="$(PkgMySqlConnector)/lib/net8.0/MySqlConnector.dll" DestinationFolder="$(OutDir)" />
    <!-- Keep the conventional auto-load entry point as well as the release-specific live-load path. -->
    <Copy SourceFiles="$(TargetPath)" DestinationFiles="$(TargetDir)VIP_Tag.dll" />
    <Copy SourceFiles="$(TargetDir)$(AssemblyName).deps.json" DestinationFiles="$(TargetDir)VIP_Tag.deps.json" />
    <Copy SourceFiles="$(TargetDir)$(AssemblyName).pdb" DestinationFiles="$(TargetDir)VIP_Tag.pdb" Condition="Exists('$(TargetDir)$(AssemblyName).pdb')" />
  </Target>
</Project>
